# Supabase – Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key (server only, bypasses RLS) – used for e-mails, cron reminders and seeding
SUPABASE_SECRET_KEY=sb_secret_...

# Public URL of the app (used in e-mail links). For Cloudflare builds put the production URL in .env.production.local.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend – https://resend.com/api-keys
RESEND_API_KEY=re_...
# Sender address; must be on a domain verified in Resend (onboarding@resend.dev works for testing)
EMAIL_FROM="Rezervo <onboarding@resend.dev>"

# Protects /api/cron/reminders (the Cloudflare cron handler sends it as a Bearer token)
CRON_SECRET=change-me-to-a-long-random-string

# Encrypts stored API keys so owners can view them in the dashboard (min. 32 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it later makes existing keys unviewable (they keep working).
API_KEY_ENCRYPTION_SECRET=

# Optional: separate secret for customers' "manage booking" links in e-mails (min. 32 chars).
# Falls back to API_KEY_ENCRYPTION_SECRET. Changing it invalidates links already sent.
BOOKING_LINK_SECRET=
